---
source: tests/cli/snapshots.rs
---
$ vendo completions zsh
exit: 0
--- stdout ---
#compdef vendo

autoload -U is-at-least

_vendo() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--profile=[Use a specific account profile (or set VENDO_PROFILE)]:name:_default' \
'--debug[Enable verbose request diagnostics]' \
'-V[Print version]' \
'--version[Print version]' \
'-h[Print help]' \
'--help[Print help]' \
":: :_vendo_commands" \
"*::: :->vendo" \
&& ret=0
    case $state in
    (vendo)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:vendo-command-$line[1]:"
        case $line[1] in
            (login)
_arguments "${_arguments_options[@]}" : \
'--api-key=[API key for headless/CI login (requires --account)]:key:_default' \
'--account=[Account ID for headless/CI login (requires --api-key)]:id:_default' \
'--env=[Target instance\: "staging" or "prod" (default\: VENDO_API_URL/profile, else prod)]:environment:(staging prod)' \
'--base-url=[Explicit API base URL (overrides --env)]:url:_default' \
'--profile=[Use a specific account profile (or set VENDO_PROFILE)]:name:_default' \
'--force[Sign in through the browser again, even when the saved API key works]' \
'--json[Output raw JSON]' \
'--debug[Enable verbose request diagnostics]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(logout)
_arguments "${_arguments_options[@]}" : \
'--profile=[Use a specific account profile (or set VENDO_PROFILE)]:name:_default' \
'--all[Remove every saved profile, not just the active one]' \
'-y[Skip the confirmation prompt for --all]' \
'--yes[Skip the confirmation prompt for --all]' \
'--json[Output raw JSON]' \
'--debug[Enable verbose request diagnostics]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(profile)
_arguments "${_arguments_options[@]}" : \
'--profile=[Use a specific account profile (or set VENDO_PROFILE)]:name:_default' \
'--debug[Enable verbose request diagnostics]' \
'-h[Print help]' \
'--help[Print help]' \
":: :_vendo__subcmd__profile_commands" \
"*::: :->profile" \
&& ret=0

    case $state in
    (profile)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:vendo-profile-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
'--profile=[Use a specific account profile (or set VENDO_PROFILE)]:name:_default' \
'--json[Output raw JSON]' \
'--debug[Enable verbose request diagnostics]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(switch)
_arguments "${_arguments_options[@]}" : \
'--account=[Switch by account ID instead of profile name]:accountId:_default' \
'--profile=[Use a specific account profile (or set VENDO_PROFILE)]:name:_default' \
'--json[Output raw JSON]' \
'--debug[Enable verbose request diagnostics]' \
'-h[Print help]' \
'--help[Print help]' \
'::profile_name:_default' \
&& ret=0
;;
(set)
_arguments "${_arguments_options[@]}" : \
'--api-key=[API key for authentication]:key:_default' \
'--base-url=[Base URL for the Vendo API]:url:_default' \
'--account=[Account ID to operate on]:id:_default' \
'--profile=[Use a specific account profile (or set VENDO_PROFILE)]:name:_default' \
'--json[Output raw JSON]' \
'--debug[Enable verbose request diagnostics]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
        esac
    ;;
esac
;;
(status)
_arguments "${_arguments_options[@]}" : \
'--profile=[Use a specific account profile (or set VENDO_PROFILE)]:name:_default' \
'--json[Output raw JSON]' \
'--debug[Enable verbose request diagnostics]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
