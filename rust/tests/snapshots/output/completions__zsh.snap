_arguments "${_arguments_options[@]}" : \
'--type=[App type (e.g. google_ads, onesignal). See\: vendo catalog list]:appType:_default' \
'--name=[Human-readable name for this app]:displayName:_default' \
'--role=[Comma-separated capability\: source, destination (derives default permissions)]:role:(source destination)' \
'--permissions=[Comma-separated granular permissions (e.g. performance_data,send_conversions). Overrides --role.]:permissions:(performance_data read_leads read_organic_content send_conversions read_warehouse write_warehouse sync_audiences campaign_changes campaign_adjust_bids campaign_adjust_spend campaign_toggle google_tag_manager google_analytics)' \
'--credentials-file=[Path to a JSON file with the credential payload]:path:_default' \
'--config-file=[Path to a JSON file with app-specific config]:path:_default' \
'--output=[Print a single field (e.g. id)]:field:_default' \
'--profile=[Use a specific account profile (or set VENDO_PROFILE)]:name:_default' \
