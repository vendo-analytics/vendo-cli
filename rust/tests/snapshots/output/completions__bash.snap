    case "${cmd}" in
        vendo)
            opts="-V -h --profile --debug --version --help login logout profile status whoami apps sources destinations jobs catalog dictionary metrics models measurement mcp completions doctor commands self-update help"
            if [[ ${cur} == -* || ${COMP_CWORD} -eq 1 ]] ; then
                COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
                return 0
            fi
            case "${prev}" in
                --profile)
                    COMPREPLY=($(compgen -f "${cur}"))
                    return 0
